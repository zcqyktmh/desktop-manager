<Window x:Class="DesktopManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面管家桌面层" Icon="Assets/desktop-mascot.png" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Background="Transparent" AllowsTransparency="True"
        Foreground="{DynamicResource PrimaryText}" FontFamily="Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale">
    <Window.Resources>
        <Style x:Key="MacScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Margin="1,2">
                        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" IsTabStop="False" Background="Transparent" BorderThickness="0" Opacity="0"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb MinHeight="24">
                                    <Thumb.Template><ControlTemplate TargetType="Thumb">
                                        <Border x:Name="ThumbChrome" Background="#71828B99" CornerRadius="4" Margin="1"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbChrome" Property="Background" Value="#C05F6875"/></Trigger>
                                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbChrome" Property="Background" Value="#DD4E5866"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate></Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" IsTabStop="False" Background="Transparent" BorderThickness="0" Opacity="0"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Background="Transparent" x:Name="RootSurface">
        <StackPanel x:Name="DesktopSurface" Margin="34,24,34,28" />
    </Grid>
</Window>

