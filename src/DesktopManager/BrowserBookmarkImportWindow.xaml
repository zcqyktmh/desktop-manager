<Window x:Class="DesktopManager.BrowserBookmarkImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入浏览器书签" Width="760" Height="650" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource SurfaceBackground}"
        Foreground="{DynamicResource PrimaryText}" FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="导入浏览器书签" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Text="选择浏览器和配置文件，再勾选要加入收藏库的网址。不会修改浏览器里的书签。" FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="0,5,0,14"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="SourcePicker" Width="210" Height="34" VerticalContentAlignment="Center" SelectionChanged="SourcePicker_SelectionChanged"/>
            <TextBox x:Name="SearchBox" Grid.Column="1" Height="34" Margin="10,0" Padding="9,5" VerticalContentAlignment="Center" ToolTip="搜索名称、网址或文件夹" TextChanged="SearchBox_TextChanged"/>
            <Button x:Name="SelectAllButton" Grid.Column="2" Content="全选" Height="34" Padding="13,0" Click="SelectAll_Click"/>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Rows" Margin="7"/>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="CountText" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                <CheckBox x:Name="ShowOnHomeCheck" Content="导入后显示在桌面" FontSize="11" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="取消" Width="78" Height="34" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button x:Name="ImportButton" Content="导入所选" Width="96" Height="34" IsDefault="True" IsEnabled="False" Click="Import_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
