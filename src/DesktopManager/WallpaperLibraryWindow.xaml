<Window x:Class="DesktopManager.WallpaperLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="壁纸库" Width="920" Height="720" MinWidth="760" MinHeight="560"
        ResizeMode="CanResize" WindowStyle="None" AllowsTransparency="False"
        WindowStartupLocation="CenterOwner" Background="#00F5F5F7"
        Foreground="#202124" FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="LineBrush" Color="#70FFFFFF"/>
        <SolidColorBrush x:Key="CardBrush" Color="#BFFFFFFF"/>
        <Style x:Key="MacButton" TargetType="Button">
            <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="13,0"/>
            <Setter Property="Background" Value="#F1F2F5"/><Setter Property="Foreground" Value="#26272B"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E7E8EC"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#DCDDE2"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="MacPrimaryButton" TargetType="Button" BasedOn="{StaticResource MacButton}">
            <Setter Property="Background" Value="#3478F6"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#2469E6"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#1858CC"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TrafficLight" TargetType="Button">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Ellipse x:Name="Light" Fill="{TemplateBinding Background}"/>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Light" Property="Opacity" Value="0.78"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="WallpaperTemplate">
            <Border Width="256" Margin="6" Padding="7" Background="#BFFFFFFF" BorderBrush="#A8FFFFFF" BorderThickness="0.6" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="144"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border CornerRadius="8" ClipToBounds="True" Background="#E5E8ED">
                        <Grid>
                            <TextBlock Text="▧" FontSize="36" Foreground="#9AA1AD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" SnapsToDevicePixels="True"/>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Margin="3,9,3,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                    <TextBlock Grid.Row="2" Text="{Binding Author}" FontSize="9" Foreground="#777982" Margin="3,3,3,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Author}"/>
                    <Grid Grid.Row="3" Margin="3,8,3,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding License}" FontSize="9" Foreground="#777982" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1" Content="来源" Tag="{Binding}" Style="{StaticResource MacButton}" Height="29" Padding="8,0" Margin="4,0" Click="OpenSource_Click"/>
                        <Button Grid.Column="2" Content="设为壁纸" Tag="{Binding}" Style="{StaticResource MacPrimaryButton}" Height="29" Padding="10,0" Click="SelectWallpaper_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Border Background="#C8F5F5F7" BorderBrush="#A8FFFFFF" BorderThickness="1" CornerRadius="14" SnapsToDevicePixels="True">
        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.22" Color="#000000"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border x:Name="TitleBar" Background="#B8F5F5F7" CornerRadius="14,14,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Button Style="{StaticResource TrafficLight}" Width="13" Height="13" Margin="0,0,8,0" Padding="0" Background="#FF5F57" ToolTip="关闭" Click="CloseWindow_Click"/>
                        <Button Style="{StaticResource TrafficLight}" Width="13" Height="13" Margin="0,0,8,0" Padding="0" Background="#FEBC2E" ToolTip="最小化" Click="MinimizeWindow_Click"/>
                        <Button Style="{StaticResource TrafficLight}" Width="13" Height="13" Padding="0" Background="#28C840" ToolTip="放大" Click="ZoomWindow_Click"/>
                    </StackPanel>
                    <TextBlock Text="壁纸库 · Wikimedia Commons" FontSize="12" FontWeight="SemiBold" Foreground="#62636A" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="28,20,28,22">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="挑选一张壁纸" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="图片来自 Wikimedia Commons。下载到本机后可离线使用；每张图片的作者与许可会显示在卡片上。" FontSize="11" Foreground="#777982" Margin="0,5,0,14" TextWrapping="Wrap"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="280" HorizontalAlignment="Left" Background="#F1F2F5" CornerRadius="9" Padding="10,0">
                        <TextBox x:Name="SearchBox" Height="35" Background="Transparent" BorderThickness="0" Foreground="#25262A" FontSize="11" VerticalContentAlignment="Center" ToolTip="搜索壁纸，例如 mountain lake" KeyDown="SearchBox_KeyDown"/>
                    </Border>
                    <Button Grid.Column="1" Content="搜索" Style="{StaticResource MacPrimaryButton}" Height="35" Padding="18,0" Click="Search_Click"/>
                </Grid>
                <WrapPanel Grid.Row="2" Margin="-3,0,0,9">
                    <Button Content="风景" Tag="landscape wallpaper panorama" Style="{StaticResource MacButton}" Margin="3,0" Click="Preset_Click"/>
                    <Button Content="自然" Tag="nature landscape panorama" Style="{StaticResource MacButton}" Margin="3,0" Click="Preset_Click"/>
                    <Button Content="星空" Tag="night sky stars landscape" Style="{StaticResource MacButton}" Margin="3,0" Click="Preset_Click"/>
                    <Button Content="海洋" Tag="ocean sea coast landscape" Style="{StaticResource MacButton}" Margin="3,0" Click="Preset_Click"/>
                    <Button Content="城市" Tag="city skyline landscape" Style="{StaticResource MacButton}" Margin="3,0" Click="Preset_Click"/>
                </WrapPanel>
                <Border Grid.Row="3" Background="#BFFFFFFF" CornerRadius="12" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="Results" ItemTemplate="{StaticResource WallpaperTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <DockPanel Grid.Row="4" Margin="0,13,0,0">
                    <TextBlock x:Name="StatusText" FontSize="10" Foreground="#777982" VerticalAlignment="Center" Text="正在载入壁纸…"/>
                    <Button Content="关闭" DockPanel.Dock="Right" Style="{StaticResource MacButton}" Width="84" Height="34" Click="CloseWindow_Click"/>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
