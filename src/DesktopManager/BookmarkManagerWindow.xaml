<Window x:Class="DesktopManager.BookmarkManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理首页书签" Width="820" Height="680" MinWidth="700" MinHeight="520"
        ResizeMode="CanResize" WindowStyle="None" AllowsTransparency="False"
        WindowStartupLocation="CenterScreen" Background="#00F5F5F7"
        Foreground="#202124" FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#202124"/>
        <SolidColorBrush x:Key="LineBrush" Color="#70FFFFFF"/>
        <SolidColorBrush x:Key="CardBrush" Color="#BFFFFFFF"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#777982"/>
        <Style x:Key="MacButton" TargetType="Button">
            <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="15,0"/>
            <Setter Property="Background" Value="#F1F2F5"/><Setter Property="Foreground" Value="#26272B"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E7E8EC"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#DCDDE2"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="MacPrimaryButton" TargetType="Button" BasedOn="{StaticResource MacButton}">
            <Setter Property="Background" Value="#3478F6"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#2469E6"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#1858CC"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TrafficLight" TargetType="Button">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Ellipse x:Name="Light" Fill="{TemplateBinding Background}"/>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Light" Property="Opacity" Value="0.78"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Light" Property="Opacity" Value="0.58"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="MacSwitch" TargetType="CheckBox">
            <Setter Property="Width" Value="42"/><Setter Property="Height" Value="25"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid Width="42" Height="25">
                    <Border x:Name="Track" Background="#D7D9DF" CornerRadius="13"/>
                    <Ellipse x:Name="Knob" Width="21" Height="21" Fill="White" HorizontalAlignment="Left" Margin="2">
                        <Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.16"/></Ellipse.Effect>
                    </Ellipse>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#34C759"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.88"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="MacCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#565963"/>
            <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Border Background="#C8F5F5F7" BorderBrush="#A8FFFFFF" BorderThickness="1" CornerRadius="14" SnapsToDevicePixels="True">
        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.22" Color="#000000"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border x:Name="TitleBar" Background="#B8F5F5F7" CornerRadius="14,14,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Button Style="{StaticResource TrafficLight}" Width="13" Height="13" Margin="0,0,8,0" Padding="0" Background="#FF5F57" ToolTip="关闭" Click="CloseWindow_Click"/>
                        <Button Style="{StaticResource TrafficLight}" Width="13" Height="13" Margin="0,0,8,0" Padding="0" Background="#FEBC2E" ToolTip="最小化" Click="MinimizeWindow_Click"/>
                        <Button Style="{StaticResource TrafficLight}" Width="13" Height="13" Padding="0" Background="#28C840" ToolTip="放大" Click="ZoomWindow_Click"/>
                    </StackPanel>
                    <TextBlock Text="管理首页书签" FontSize="12" FontWeight="SemiBold" Foreground="#62636A" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="32,22,32,24">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="管理首页书签" FontSize="25" FontWeight="Bold" Foreground="#202124"/>
                    <TextBlock Text="勾选“显示在桌面”，就会把网址卡片放到桌面壁纸上。取消勾选只隐藏，不会删除收藏。" FontSize="12" Foreground="#777982" Margin="0,5,0,18" TextWrapping="Wrap"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="300" HorizontalAlignment="Left" Background="#F1F2F5" CornerRadius="9" Padding="10,0">
                        <TextBox x:Name="SearchBox" Height="36" Background="Transparent" BorderThickness="0" Foreground="#25262A" FontSize="12" VerticalContentAlignment="Center" ToolTip="搜索名称、网址或文件夹" TextChanged="SearchBox_TextChanged"/>
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="导入浏览器" Style="{StaticResource MacButton}" Height="36" Margin="0,0,8,0" Click="ImportBrowser_Click"/>
                        <Button Content="＋ 添加网址" Style="{StaticResource MacPrimaryButton}" Height="36" Click="Add_Click"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="8,4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="Rows"/>
                    </ScrollViewer>
                </Border>
                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="CountText" FontSize="11" Foreground="#777982" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="完成" Style="{StaticResource MacPrimaryButton}" Width="92" Height="36" IsDefault="True" Click="Done_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
